PORT=5000
# Paste your Atlas connection string. Keep /taskflow before the ? so data goes in a database named "taskflow".
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/taskflow?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
